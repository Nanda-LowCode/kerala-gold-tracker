{
  // Cloudflare Workers config for the livegoldkerala Next.js app,
  // generated via the OpenNext Cloudflare adapter (see open-next.config.ts).
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "livegoldkerala",
  // Compatibility date — bumped to Nov 2026 (migration date). Required flags:
  // - nodejs_compat: Node built-ins for @opennextjs runtime
  // - global_fetch_strictly_public: lets ISR revalidation fetch its own routes
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Serve the production domains from this Worker. The apex → www redirect
  // is handled by next.config.ts.
  "routes": [
    { "pattern": "livegoldkerala.com", "custom_domain": true },
    { "pattern": "www.livegoldkerala.com", "custom_domain": true }
  ],

  // Static assets bundle produced by `opennextjs-cloudflare build`.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Self-reference service binding — needed by OpenNext so the worker can
  // call itself for revalidation. The `service` value must match `name`.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "livegoldkerala"
    }
  ],

  // R2 bucket for ISR / fetch cache. The bucket must exist before deploy —
  // provisioned via `wrangler r2 bucket create livegoldkerala-opennext-cache`
  // or the Cloudflare dashboard.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "livegoldkerala-opennext-cache"
    }
  ],

  // Durable Objects backing the ISR revalidation queue and the tag cache
  // (see open-next.config.ts). The classes are exported by .open-next/worker.js.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }
  ],

  // Cloudflare's hosted image optimization (replaces next/image's Vercel
  // backend). See https://opennext.js.org/cloudflare/howtos/image
  "images": {
    "binding": "IMAGES"
  }
}
